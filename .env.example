# Links used by the landing page. Only https: (and mailto: for contact) are accepted.
# When a variable is empty or invalid, the link falls back as documented in src/config/links.ts:
#   VITE_APP_URL     -> "#configurar" (the in-page configurator)
#   the others       -> the link is not rendered at all (never a dead "#")
VITE_APP_URL=
VITE_LOGIN_URL=
VITE_CONTACT_URL=
VITE_PRIVACY_URL=
VITE_TERMS_URL=

# Absolute site URL for canonical and Open Graph tags (no trailing slash).
# On Netlify it defaults to the deploy's URL.
VITE_SITE_URL=
